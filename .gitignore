# ============================================================
# pickle-backend/.gitignore
# ============================================================
# This gitignore is your last line of defense against credential leaks.
# NEVER override these with git add -f

# ── Environment / Secrets — NEVER commit these ───────────────
.env
.env.*
.env.local
.env.production
.env.development
.env.staging
!.env.example        # .env.example IS committed (it has no real values)

# ── Node modules ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log

# ── Logs — ephemeral, never commit ───────────────────────────
logs/
*.log

# ── Build / dist output ───────────────────────────────────────
dist/
build/

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Test coverage ─────────────────────────────────────────────
coverage/
.nyc_output/

# ── Temporary uploads ─────────────────────────────────────────
uploads/
tmp/
